# Banco de dados PostgreSQL. Obrigatório.
DATABASE_URL=

# URL pública do site, sem barra final. Usada para montar as URLs de retorno
# enviadas ao gateway. Em desenvolvimento pode ficar vazia (assume
# http://localhost:3000).
APP_BASE_URL=

# --- Pagamentos (InfinitePay) ---------------------------------------------
# Sua InfiniteTag, sem "@" ou "$". Não é secreta — é o identificador público
# da sua conta. Sem ela, o site cria inscrições normalmente, mas a tela de
# pagamento avisa que ainda não está configurada.
INFINITEPAY_HANDLE=

# Opcional: só necessário se sua conta exigir Bearer token para consultar
# status de pagamento.
INFINITEPAY_API_TOKEN=

# Segredo que você mesmo escolhe (ex.: `openssl rand -base64 32`) e que o site
# embute na URL de webhook enviada à InfinitePay na criação de cada link. Sem
# ele, o endpoint de webhook recusa qualquer chamada.
INFINITEPAY_WEBHOOK_SECRET=

# --- Painel administrativo --------------------------------------------------
# ADMIN_EMAIL não precisa ter formato de e-mail de verdade — é só um segundo
# campo de identificação, somado à senha.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# `openssl rand -base64 48`
ADMIN_SESSION_SECRET=
